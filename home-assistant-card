type: custom:tabbed-card
options: {}
styles:
  "--mdc-theme-primary": null
  "--mdc-tab-text-label-color-default": grey
tabs:
  - attributes:
      label: null
      icon: mdi:home-assistant
    card:
      type: custom:vertical-stack-in-card
      cards:
        - show_state: true
          show_name: true
          camera_view: auto
          fit_mode: cover
          type: picture-entity
          entity: sensor.dream_machine_pro_state
          image:
            media_content_id: media-source://image_upload/47b7317750bac968147ded39a193a5e0
            media_content_type: image/png
          name: Home Assistant Server
        - type: custom:gap-card
          height: 5
        - type: heading
          icon: mdi:home-assistant
          heading: Home Assistant
          heading_style: title
          badges:
            - type: entity
              show_state: true
              show_icon: true
              entity: input_button.home_button
              name: 16 GB
              icon: mdi:memory
              state_content: name
              color: primary
            - type: entity
              show_state: true
              show_icon: true
              entity: input_button.home_button
              name: 256 GB
              icon: mdi:harddisk
              state_content: name
              color: primary
        - type: heading
          icon: ""
          heading: RAM and CPU
          heading_style: subtitle
          badges:
            - type: entity
              show_state: true
              show_icon: true
              entity: sensor.processor_use
              color: accent
              tap_action:
                action: more-info
            - type: entity
              show_state: true
              show_icon: true
              entity: sensor.memory_use_percent
              color: accent
              tap_action:
                action: more-info
        - type: heading
          icon: ""
          heading: Storage
          heading_style: subtitle
          badges:
            - type: entity
              show_state: true
              show_icon: true
              entity: sensor.home_assistant_host_disk_used
              name: used
              icon: mdi:harddisk
              color: accent
              state_content:
                - name
                - state
              tap_action:
                action: more-info
        - type: custom:gap-card
          height: 15
        - type: heading
          icon: null
          heading: Home Assistant Core
          heading_style: subtitle
          badges:
            - type: entity
              show_state: true
              show_icon: true
              entity: sensor.home_assistant_core_cpu_percent
              color: accent
              tap_action:
                action: more-info
            - type: entity
              show_state: true
              show_icon: true
              entity: sensor.home_assistant_core_memory_percent
              color: accent
              tap_action:
                action: more-info
        - type: heading
          icon: ""
          heading: Home Assistant Supervisor
          heading_style: subtitle
          badges:
            - type: entity
              show_state: true
              show_icon: true
              entity: sensor.home_assistant_supervisor_cpu_percent
              color: accent
              tap_action:
                action: more-info
            - type: entity
              show_state: true
              show_icon: true
              entity: sensor.home_assistant_supervisor_memory_percent
              color: accent
              tap_action:
                action: more-info
        - type: heading
          icon: null
          heading: Home Assistant OS
          heading_style: subtitle
          badges:
            - type: entity
              show_state: true
              show_icon: false
              entity: sensor.home_assistant_operating_system_version
              name: version
              color: accent
              state_content:
                - name
                - state
              tap_action:
                action: more-info
        - type: heading
          icon: ""
          heading: Last Restart -->
          heading_style: subtitle
          badges:
            - type: entity
              show_state: true
              show_icon: true
              entity: sensor.last_boot
              tap_action:
                action: more-info
        - type: custom:gap-card
          height: 15
        - type: custom:gap-card
          height: 15
        - type: custom:gap-card
          height: 5
      show_header_toggle: false
      state_color: true
      title: null
  - attributes:
      label: null
      icon: mdi:folder-plus-outline
